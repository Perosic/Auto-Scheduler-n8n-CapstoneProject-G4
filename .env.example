# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=auto_scheduler

# n8n
N8N_PORT=5678

# Streamlit → n8n webhooks (defaults match the committed workflows)
# Change only if you change the webhook path inside n8n.
N8N_SCHEDULE_WEBHOOK_URL=http://localhost:5678/webhook/08190fdc-b0cf-4c0f-a7c0-b6c60e7595e2
N8N_SEND_SCHEDULE_URL=http://localhost:5678/webhook/send-schedule

# Slack (optional P1 plain message / P2 interactive — not required for core demo)
# SLACK_WEBHOOK_URL=
# SLACK_BOT_TOKEN=

# Gemini is configured inside n8n (Google Gemini Chat Model credential), not via this file.

# Optional: Google OAuth values for reference only — Gmail credentials are created inside n8n.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
