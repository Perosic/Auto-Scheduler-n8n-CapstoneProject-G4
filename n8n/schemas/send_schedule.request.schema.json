{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Send Schedule Request",
  "description": "Body for POST /webhook/send-schedule (n8n Gmail Timetable Sender).",
  "type": "object",
  "required": ["recipient", "schedule"],
  "properties": {
    "recipient": {
      "type": "string",
      "description": "One email address, or several separated by commas.",
      "examples": ["student@example.com"]
    },
    "subject": {
      "type": "string",
      "description": "Optional. Defaults to \"Your Course Timetable\"."
    },
    "schedule": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["course", "day", "time", "room"],
        "properties": {
          "course": { "type": "string", "examples": ["CSC101"] },
          "title": { "type": "string", "examples": ["Computer Science"] },
          "day": { "type": "string", "examples": ["Monday"] },
          "time": { "type": "string", "examples": ["09:00 - 11:00"] },
          "room": { "type": "string", "examples": ["CR101"] }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
